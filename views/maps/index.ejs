
<% layout("/layouts/boilerplate") %>

<div class="container mt-4 mb-5">

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">

        <div>
            <h2>Explore All Listings</h2>

            <p class="text-muted">
                Discover all available listings on the map.
            </p>
        </div>

        <a href="/listings" class="btn btn-dark">
            Back to Listings
        </a>

    </div>

    <div class="map-info mb-3">
        <i class="fa-solid fa-location-dot"></i>
        <span id="mapListingCount">Loading listings...</span>
    </div>

    <div id="allListingsMap" class="all-listings-map"></div>

    <div class="mt-3 text-muted">
        <small>
            Map data © OpenStreetMap contributors.
        </small>
    </div>

</div>

<script
    id="map-listings-data"
    type="application/json"
><%- mapListingsJson %></script>
