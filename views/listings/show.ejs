
<% layout("/layouts/boilerplate") %>

<div class="row mt-3">

    <div class="col-8 offset-3">
        <h3><%= listing.title %></h3>
    </div>

    <!-- Listing Details -->
    <div class="card col-6 offset-3 show-card listing-card">

        <img
            src="<%= listing.image?.url || listing.image || '' %>"
            class="card-img-top show-img"
            alt="listing-image"
        />

        <div class="card-body">

            <p class="card-text">
                Owned by <i><%= listing.owner?.username || "Unknown" %></i>
            </p>

            <p class="card-text"><%= listing.description %></p>

            <p class="card-text">
                &#8377; <%= Number(listing.price || 0).toLocaleString("en-IN") %>
            </p>

            <p class="card-text"><%= listing.location %></p>

            <p class="card-text"><%= listing.country %></p>

        </div>
    </div>

    <!-- Individual Listing Map -->
    <div class="col-8 offset-2 mt-4 mb-4">

        <h4>
            <i class="fa-solid fa-location-dot"></i>
            Listing Location
        </h4>

        <% if (
            Number.isFinite(listing.latitude) &&
            Number.isFinite(listing.longitude) &&
            listing.latitude >= -90 &&
            listing.latitude <= 90 &&
            listing.longitude >= -180 &&
            listing.longitude <= 180
        ) { %>

            <div
                id="individualMap"
                class="listing-map"
                data-latitude="<%= listing.latitude %>"
                data-longitude="<%= listing.longitude %>"
                data-title="<%= listing.title %>"
                data-location="<%= listing.location %>"
            ></div>

        <% } else { %>

            <div class="alert alert-info">
                Map location is not available for this listing yet.
                Please add latitude and longitude using the Edit button.
            </div>

        <% } %>

    </div>

    <!-- Edit and Delete Buttons -->
    <% if (
        currUser &&
        listing.owner &&
        listing.owner._id.equals(currUser._id)
    ) { %>

        <div class="btns">

            <a
                href="/listings/<%= listing._id %>/edit"
                class="btn btn-dark col-1 offset-3 edit-btn"
            >
                Edit
            </a>

            <form
                method="POST"
                action="/listings/<%= listing._id %>?_method=DELETE"
            >
                <button class="btn btn-dark offset-5">
                    Delete
                </button>
            </form>

        </div>

    <% } %>

    <!-- Review Section -->
    <div class="col-8 offset-3 mb-3">

        <hr />

        <% if(currUser) { %>

            <h4>Leave a Review</h4>

            <form
                action="/listings/<%= listing._id %>/reviews"
                method="POST"
                novalidate
                class="needs-validation"
            >

                <div class="mb-3 mt-3">

                    <label class="form-label d-block">
                        Rating
                    </label>

                    <fieldset class="custom-star-rating">

                        <input type="radio" id="rate1" name="review[rating]" value="1" checked />
                        <label for="rate1" title="1 star">★</label>

                        <input type="radio" id="rate2" name="review[rating]" value="2" />
                        <label for="rate2" title="2 stars">★</label>

                        <input type="radio" id="rate3" name="review[rating]" value="3" />
                        <label for="rate3" title="3 stars">★</label>

                        <input type="radio" id="rate4" name="review[rating]" value="4" />
                        <label for="rate4" title="4 stars">★</label>

                        <input type="radio" id="rate5" name="review[rating]" value="5" />
                        <label for="rate5" title="5 stars">★</label>

                    </fieldset>

                </div>

                <div class="mb-3 mt-3">

                    <label for="comment" class="form-label">
                        Comments
                    </label>

                    <textarea
                        name="review[comment]"
                        id="comment"
                        cols="30"
                        rows="5"
                        class="form-control"
                        required
                    ></textarea>

                    <div class="invalid-feedback">
                        Please add some comments for your review.
                    </div>

                </div>

                <button class="btn btn-outline-dark">
                    Submit
                </button>

            </form>

            <hr />

        <% } %>

        <!-- All Reviews -->
        <p><b>All Reviews</b></p>

        <div class="row">

            <% for(let review of listing.reviews) { %>

                <div class="card col-5 ms-3 mb-3">

                    <div class="card-body">

                        <h5 class="card-title">
                            @<%= review.author?.username || "User" %>
                        </h5>

                        <div class="review-stars">

                            <% for(let i = 1; i <= 5; i++) { %>

                                <span class="<%= i <= review.rating ? 'filled' : 'empty' %>">
                                    ★
                                </span>

                            <% } %>

                        </div>

                        <p class="card-text">
                            <%= review.comment %>
                        </p>

                        <form
                            class="mb-3"
                            method="POST"
                            action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                        >

                            <button class="btn btn-sm btn-dark">
                                Delete
                            </button>

                        </form>

                    </div>

                </div>

            <% } %>

        </div>

    </div>

</div>
